{
	"name": "@canonry/db",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./schema": "./src/schema/index.ts"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"check": "tsc -p tsconfig.json --noEmit",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test": "TEST_DB_SUFFIX=$$ vitest run",
		"migrate": "tsx src/migrate.ts",
		"generate": "drizzle-kit generate",
		"seed": "tsx src/seed-fixture.ts",
		"publish-world": "tsx src/publish-world.ts"
	},
	"dependencies": {
		"@canonry/lang": "workspace:*",
		"drizzle-orm": "^0.45.2",
		"postgres": "^3.4.9"
	},
	"devDependencies": {
		"@types/node": "^22",
		"better-auth": "^1.7.2",
		"drizzle-kit": "^0.31.10",
		"prettier": "^3.8.3",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
