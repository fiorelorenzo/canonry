# pnpm 11 reconciles the whole workspace before running any script, so a bare
# `pnpm --filter <pkg> test` triggers a full recursive install. That is fine for one
# person and destructive when several processes run scripts at once, since each
# reconciliation rebuilds node_modules under the others. Installs here are explicit.
verify-deps-before-run=false

# The engines field in the root package.json is a real constraint, not a hint: the
# deploy runs Node 22 and adapter-node output is built against it.
engine-strict=true
