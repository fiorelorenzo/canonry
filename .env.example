# Copy to .env and fill in real values. .gitignore already excludes .env and
# .env.* (except this file), so the real one never gets committed.
#
# Consumed by docker/compose.yml both for its own ${VAR} substitution (image
# tag/build args) and, via env_file, as the web and postgres containers'
# runtime environment. APP_VERSION and APP_COMMIT are deliberately absent:
# they are baked into the image at build time (docker/Dockerfile build args),
# and must never be runtime-overridable or the deploy health gate (SPEC.md
# #12, "served version against the built artifact") becomes meaningless.

# Postgres connection string the web app and packages/db use. Inside
# docker/compose.yml this must use the "postgres" service name as host, not
# 127.0.0.1 -- containers reach each other by service name, not loopback.
DATABASE_URL=postgres://canonry:canonry@postgres:5432/canonry

# Credentials postgres's own image reads to initialise the database. Keep in
# sync with the credentials embedded in DATABASE_URL above.
POSTGRES_USER=canonry
POSTGRES_PASSWORD=canonry-dev-password-change-me
POSTGRES_DB=canonry

# Qdrant's HTTP API, reached by service name inside the compose network.
QDRANT_URL=http://qdrant:6333

# The public URL this deployment is served at. SvelteKit checks the Origin
# header on form POSTs against this value; behind Caddy the request's real
# Origin is the public URL, not http://127.0.0.1:5196, so leaving this unset
# or wrong makes every form submission fail with 403 while the build stays
# green. Set this to the exact scheme+host+port users hit from outside.
ORIGIN=https://canonry.example.com

# Port the SvelteKit server binds to inside its container. Must match the
# container-side half of docker/compose.yml's web port mapping (5196).
PORT=5196

# Cloudflare AI Gateway: account id and gateway name form the request path
# (/v1/{account}/{gateway}/...), the API key authenticates against it.
AI_GATEWAY_ACCOUNT_ID=00000000000000000000000000000000
AI_GATEWAY_NAME=canonry-dev
AI_GATEWAY_API_KEY=cf-aig-0000000000000000000000000000000000000000

# Optional override of the gateway host for the Replicate REST path only, which
# is the one path that builds its own URL. Text generation always goes to
# Cloudflare, because ai-gateway-provider hardcodes that host and offers no
# override, so setting this does not redirect model calls. Leave unset in real
# deployments.
# AI_GATEWAY_BASE_URL=http://127.0.0.1:8787

# Replicate is billed BYOK through the gateway, so images need a real Replicate
# token in addition to the gateway credentials above.
REPLICATE_API_TOKEN=r8_000000000000000000000000000000000000000
