[Unit]
Description=Canonry Postgres backup for stack %i
# The stack has to actually be up for `docker exec` into its postgres
# container to work.
After=docker.service
Requires=docker.service
OnFailure=canonry-backup-alert@%n.service

[Service]
Type=oneshot
# Every file and directory this unit creates (backups/, backups/postgres/,
# backups/status/, the dumps themselves) is owned by prod and mode 700/600:
# a dump is a full plaintext copy of the database, so the backup volume
# must never be world- or group-readable regardless of the parent
# directory's own mode.
UMask=0077
# Optional: ALERT_WEBHOOK_URL, for canonry-backup-alert@.service. Absent by
# default (the leading `-` makes a missing file not an error), created once
# per stack alongside shared/secrets.env if wanted.
EnvironmentFile=-/opt/apps/canonry/%i/shared/backup.env
# Points at BASE/current, not a fixed version, so a rollback to an older
# release also rolls the backup script back to what shipped with it.
# --retain-days is left at the script's own default (14); adjust here per
# stack if that ever needs to differ.
ExecStart=/opt/apps/canonry/%i/current/scripts/deploy/backup-postgres.sh \
	--container canonry-%i-postgres-1 \
	--out-dir /opt/apps/canonry/%i/backups/postgres \
	--status-dir /opt/apps/canonry/%i/backups/status

# Runs as `prod`, the same user every release, rollback and other prodbox
# app already runs as (it owns /opt/apps/canonry/%i and is in the `docker`
# group), rather than a separate service account nothing on this box
# actually provisions.
User=prod
Group=prod
