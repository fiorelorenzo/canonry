# Template for a stack's shared/secrets.env on prodbox (SPEC.md #12: separate
# secrets per stack). Copy to /opt/canonry/<stack>/shared/secrets.env, fill in
# real values, and `chmod 600` it -- release.sh reads this file and copies it
# (plus the release-specific WEB_IMAGE/APP_VERSION/APP_COMMIT) into every
# releases/<sha>/.env, but never writes to this file itself. This file is
# never committed; only this template is.
#
# prod and preview need different POSTGRES_PASSWORD, different ports (so both
# stacks' containers can publish to loopback on the same box without
# colliding) and their own Qdrant instance -- see docker/Caddyfile.example
# for the port convention (prod 5196, preview 5296).

WEB_PORT=5196
POSTGRES_PORT=5432
QDRANT_PORT=6333

POSTGRES_USER=canonry
POSTGRES_PASSWORD=change-me-generate-a-real-secret
POSTGRES_DB=canonry
DATABASE_URL=postgres://canonry:change-me-generate-a-real-secret@postgres:5432/canonry

QDRANT_URL=http://qdrant:6333

ORIGIN=https://canonry.example.com

AI_GATEWAY_ACCOUNT_ID=00000000000000000000000000000000
AI_GATEWAY_NAME=canonry-prod
AI_GATEWAY_API_KEY=cf-aig-0000000000000000000000000000000000000000

REPLICATE_API_TOKEN=r8_000000000000000000000000000000000000000

ADMIN_TOKEN=change-me-generate-a-real-secret
