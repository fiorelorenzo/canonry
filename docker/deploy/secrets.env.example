# Template for a stack's shared/secrets.env on prodbox (SPEC.md #12: separate
# secrets per stack). Copy to /opt/apps/canonry/<stack>/shared/secrets.env, fill in
# real values, and `chmod 600` it -- release.sh reads this file and copies it
# (plus the release-specific WEB_IMAGE/APP_VERSION/APP_COMMIT) into every
# releases/<sha>/.env, but never writes to this file itself. This file is
# never committed; only this template is.
#
# prod and preview need different POSTGRES_PASSWORD, different ports (so both
# stacks' containers can publish to loopback on the same box without
# colliding) and their own Qdrant instance -- see docker/Caddyfile.example
# for the port convention (prod 5196, preview 5296).

WEB_PORT=5196
POSTGRES_PORT=5432
QDRANT_PORT=6333

# POSTGRES_PASSWORD is interpolated straight into DATABASE_URL's DSN below, so it
# has to be URL-safe: an unencoded `+`, `/` or `=` -- exactly what
# `openssl rand -base64 32` can hand you -- silently shifts everything after it
# out of host:port and into the wrong place, and release.sh's DATABASE_URL check
# catches that as a refusal to deploy, not as an app that works. Generate with
# `openssl rand -base64 32 | tr '+/' '-_' | tr -d '='` or `openssl rand -hex 32`
# instead, and use the same command for BETTER_AUTH_SECRET below.
POSTGRES_USER=canonry
POSTGRES_PASSWORD=change-me-generate-a-real-secret
POSTGRES_DB=canonry
DATABASE_URL=postgres://canonry:change-me-generate-a-real-secret@postgres:5432/canonry

QDRANT_URL=http://qdrant:6333

ORIGIN=https://canonry.example.com

# Vercel AI Gateway (`@ai-sdk/gateway`) for text and embeddings. AI_GATEWAY_API_KEY
# used to be a Cloudflare token (`cf-aig-...`); that value is a perfectly
# well-formed string that now authenticates against nothing, which is exactly how
# an operator loses an hour chasing a "credential" that used to work. A Vercel key
# starts `vck_...` and is project-scoped. AI_GATEWAY_ACCOUNT_ID and AI_GATEWAY_NAME
# no longer exist - a leftover value for either is simply ignored, not an error.
AI_GATEWAY_API_KEY=vck_0000000000000000000000000000000000000000000000000000

# Images go direct to Replicate, not through the gateway - Vercel's AI Gateway has
# no Replicate route (SPEC.md §11.1). Required: every image generation call needs it.
REPLICATE_API_TOKEN=r8_000000000000000000000000000000000000000

# Ambient sound goes direct to ElevenLabs too, for the same reason: Vercel's
# gateway carries no sound-generation route (SPEC.md §11.1). Required: every
# ambient layer (SPEC.md §8.2) needs it.
ELEVENLABS_API_KEY=sk_0000000000000000000000000000000000000000000000

# Better Auth (issue #86). Required - the app throws at startup without it.
BETTER_AUTH_SECRET=change-me-generate-a-real-secret

# Social sign-in: both halves of a pair or neither. At least one provider should be
# configured in a real deployment (issue #86); leave both unset for email/password
# only.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails allowed into /admin. Empty means nobody can reach it.
STAFF_EMAILS=
